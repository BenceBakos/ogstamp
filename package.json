{
  "name": "ogstamp",
  "version": "0.1.0",
  "description": "Tiny client for the OG Stamp Open Graph image API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "open-graph",
    "og-image",
    "social-card",
    "ogstamp",
    "png"
  ],
  "author": "Bence Bakos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenceBakos/ogstamp.git"
  },
  "homepage": "https://ogstamp.com",
  "bugs": {
    "url": "https://github.com/BenceBakos/ogstamp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
